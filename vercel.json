{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "app.py": {
      "excludeFiles": "{tests/**,vercel-poc/**,.codex/**,.github/**,docs/**}",
      "includeFiles": "{examples/*.csv,jaal_topology/assets/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
